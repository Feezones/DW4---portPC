<?xml version="1.0" encoding="utf-8"?>
<!-- Só os pacotes que vêm com a Godot 4.7.2 .NET (pasta GodotSharp\Tools\nupkgs), sem consultar o nuget.org.
     Defina DW4_GODOT_NUPKGS com o caminho dessa pasta antes de compilar (tools/scripts/cliente.ps1 faz isso). -->
<configuration>
  <packageSources>
    <clear />
    <add key="godot-local" value="%DW4_GODOT_NUPKGS%" />
  </packageSources>
</configuration>
