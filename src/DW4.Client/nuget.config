<?xml version="1.0" encoding="utf-8"?>
<!-- Os pacotes da Godot vêm da pasta que vem com a Godot 4.7.2 .NET (GodotSharp\Tools\nupkgs): defina DW4_GODOT_NUPKGS com
     esse caminho antes de compilar (tools/scripts/cliente.ps1 faz isso). Do nuget.org só a LiteNetLib (online, ADR 0003). -->
<configuration>
  <packageSources>
    <clear />
    <add key="godot-local" value="%DW4_GODOT_NUPKGS%" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="godot-local">
      <package pattern="*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="LiteNetLib" />
    </packageSource>
  </packageSourceMapping>
</configuration>
