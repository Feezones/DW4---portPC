<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 para o cliente Godot 4.7 .NET e um futuro servidor; os testes (net10.0) referenciam normalmente. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Os SYS* dos scripts leem e gravam o estado do jogador (Inventory, Evolution). -->
    <ProjectReference Include="..\DW4.Gameplay\DW4.Gameplay.csproj" />
  </ItemGroup>

</Project>
