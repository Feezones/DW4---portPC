<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Protocolo do online e regras do servidor sem socket (salas, quem vê quem), testáveis sem rede. Sem pacotes: o
         transporte (LiteNetLib) fica no servidor e no cliente. net8.0 por causa do cliente Godot. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
